<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Color mode section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_color_mode_label"
        android:textSize="13sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textColor="@color/text_hint"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <RadioGroup
        android:id="@+id/colorModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <RadioButton
            android:id="@+id/radioSystem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_mode_system"
            android:textSize="16sp"
            android:paddingStart="8dp" />

        <RadioButton
            android:id="@+id/radioLight"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_mode_light"
            android:textSize="16sp"
            android:paddingStart="8dp" />

        <RadioButton
            android:id="@+id/radioDark"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_mode_dark"
            android:textSize="16sp"
            android:paddingStart="8dp" />

    </RadioGroup>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Text size section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_text_size_label"
        android:textSize="13sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textColor="@color/text_hint"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp" />

    <!-- Live "Aa" preview -->
    <TextView
        android:id="@+id/textSizePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_text_size_preview"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <SeekBar
        android:id="@+id/textSizeSeekBarSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:max="64"
        android:progress="16"
        android:thumb="@drawable/seekbar_thumb"
        android:splitTrack="false" />

    <!-- Size labels: Small / Large -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_text_size_small"
            android:textSize="12sp"
            android:textColor="@color/text_hint" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_text_size_large"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:gravity="end" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Center text toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_center_text"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/centerTextSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>
    
    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Brightness section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_brightness_label"
        android:textSize="13sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textColor="@color/text_hint"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp" />

    <RadioGroup
        android:id="@+id/brightnessGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <RadioButton
            android:id="@+id/radioBrightnessFull"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_brightness_full"
            android:textSize="16sp"
            android:paddingStart="8dp" />

        <RadioButton
            android:id="@+id/radioBrightnessMedium"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_brightness_medium"
            android:textSize="16sp"
            android:paddingStart="8dp" />

        <RadioButton
            android:id="@+id/radioBrightnessNoChange"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_brightness_no_change"
            android:textSize="16sp"
            android:paddingStart="8dp" />

    </RadioGroup>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Slider side section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_slider_side_label"
        android:textSize="13sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textColor="@color/text_hint"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <RadioGroup
        android:id="@+id/sliderSideGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

      <RadioButton
          android:id="@+id/radioSliderLeft"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:text="@string/settings_slider_side_left"
          android:textSize="16sp"
          android:paddingStart="8dp" />

      <RadioButton
          android:id="@+id/radioSliderRight"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:text="@string/settings_slider_side_right"
          android:textSize="16sp"
          android:paddingStart="8dp" />

    </RadioGroup>
    
    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Version -->
    <TextView
        android:id="@+id/versionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="12dp" />

  </LinearLayout>
</ScrollView>
